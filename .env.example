# Local development defaults only. Run pnpm env:setup to create .env.
NODE_ENV=development
LOG_LEVEL=info
LOG_PRETTY=true

PORT=8000
HTTP_REQUEST_TIMEOUT_MS=30000
HTTP_HEADERS_TIMEOUT_MS=20000
HTTP_KEEP_ALIVE_TIMEOUT_MS=5000
# Must exceed DB_STATEMENT_TIMEOUT_MS + 4000 and stay below Compose's stop grace period.
SHUTDOWN_TIMEOUT_MS=20000

DB_PORT=55432
DB_USER=starter
DB_PASSWORD=starter-local
DB_NAME=starter
DATABASE_URL=postgres://starter:starter-local@127.0.0.1:55432/starter
DB_POOL_MAX=10
DB_CONNECTION_TIMEOUT_MS=5000
DB_POOL_IDLE_TIMEOUT_MS=10000
DB_READINESS_TIMEOUT_MS=1000
DB_STATEMENT_TIMEOUT_MS=15000

REDIS_PORT=56379
REDIS_PASSWORD=starter-local
REDIS_URL=redis://default:starter-local@127.0.0.1:56379/0
REDIS_COMMAND_TIMEOUT_MS=100
REDIS_CONNECT_TIMEOUT_MS=2000
