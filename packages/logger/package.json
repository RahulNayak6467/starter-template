{
  "name": "@starter/logger",
  "version": "0.0.0",
  "private": true,
  "description": "Pino logger with redaction and safe error serialization",
  "type": "module",
  "exports": {
    ".": {
      "@starter/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "node --eval \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --root ../.. --passWithNoTests packages/logger/"
  },
  "dependencies": {
    "pino": "10.4.0"
  },
  "devDependencies": {
    "pino-pretty": "13.2.0"
  }
}
