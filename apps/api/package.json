{
  "name": "@starter/api",
  "version": "0.0.0",
  "private": true,
  "description": "Example HTTP API with health probes and request middleware",
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=../../.env --conditions=@starter/source --watch --import tsx src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "clean": "node --eval \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "start": "node --env-file-if-exists=../../.env --enable-source-maps dist/main.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --root ../.. --passWithNoTests apps/api/",
    "openapi:generate": "node --conditions=@starter/source --import tsx scripts/generate-openapi.ts && prettier --write --log-level warn openapi.json",
    "openapi:check": "node --conditions=@starter/source --import tsx scripts/check-openapi.ts"
  },
  "dependencies": {
    "@starter/config": "workspace:*",
    "@starter/database": "workspace:*",
    "@starter/logger": "workspace:*",
    "@starter/redis": "workspace:*",
    "@starter/shared": "workspace:*",
    "express": "5.3.0",
    "zod": "catalog:",
    "zod-openapi": "6.0.2"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/supertest": "7.2.1",
    "supertest": "7.3.1"
  }
}
